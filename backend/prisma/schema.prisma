generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int          @id @default(autoincrement())
  username      String       @unique
  password      String       // Hashed with bcrypt
  apiKey        String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  totalScore    Int          @default(0)
  totalBounty   Int          @default(0)
  tasksCompleted Int         @default(0)
  tier          String       @default("Novice") // Novice, Apprentice, Expert, Master

  chessElo            Int       @default(1200)
  chessStreak         Int       @default(0)
  chessLastPlayedDate String?   // "YYYY-MM-DD", null = never played
  chessXpTotal        Int       @default(0)

  submissions   Submission[]
  userProgress  UserProgress[]
  mcpConnections MCPConnection[]
  createdTasks  Task[]
  createdCourses Course[]
  likes         Like[]
  comments      Comment[]
  interactionRounds InteractionRound[]
  debateHistory DebateHistory[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  icon  String
  tasks Task[]
}

model Task {
  id          String  @id // M001, A001, etc.
  name        String
  tier        String // easy, medium, hard
  bounty      Int     // Point value
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  catIcon     String
  question    String
  hint        String?
  answer      String
  refAccuracy    Int
  refReasoning   Int
  refCreativity  Int
  refSpeed       Int
  steps         String // JSON string of Array of [type, text] tuples
  illustration  String? // Generated SVG; null = not yet generated
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(true)
  // --- Interactive turn-based support ---
  isInteractive Boolean @default(false)
  interactionType String? // "dialogue", "game", "puzzle", "simulation"
  interactionConfig String? // JSON configuration for the interaction
  rounds        Int?     // expected number of rounds (optional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]
  lessons     Lesson[]
  likes         Like[]
  comments      Comment[]
  interactionRounds InteractionRound[]
}

model Submission {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  lessonId   Int?
  lesson     Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  userAnswer String?

  accuracy    Int
  reasoning   Int
  creativity  Int
  speed       Int
  totalScore  Int
  bountyEarned Int

  grade String // S, A, B, C, D

  createdAt DateTime @default(now())
}

// --- LLM Agent Learning Platform - Course by difficulty tier
model Course {
  id          Int      @id @default(autoincrement())
  name        String   // e.g., "Beginner: MCP Basics", "Intermediate: Tool Reasoning"
  description String
  difficulty  String   // "beginner", "intermediate", "advanced"
  icon        String   // emoji icon
  order       Int      // display order
  isActive    Boolean  @default(true)
  authorId    Int?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]
}

model Lesson {
  id          Int       @id @default(autoincrement())
  courseId    Int
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  taskId      String    // reference to the task
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  order       Int       // order within course
  requiresLessonId Int?  // previous lesson required to unlock this one
  bounty      Int       // bounty points awarded when completed
  isMcpTask  Boolean @default(false)  // whether this lesson requires MCP tool usage

  submissions Submission[]
  userProgress UserProgress[]
}

model UserProgress {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  Int
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(true)
  completedAt DateTime @default(now())
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([userId, taskId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int
  taskId    String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Store interactive session history for turn-based tasks
model InteractionRound {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sessionId   String   // Unique per interaction session (user + task + restart)
  roundNumber Int      // current round number (starting from 1)
  userInput   String?  // user's input/action in this round
  systemResponse String? // system/AI response to user's action
  timestamp   DateTime @default(now())
  
  // For game states - store the full game state as JSON
  gameState   String?  // JSON string of current game state after this round
}

// Store user's MCP server connections
model MCPConnection {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   // user-given name for this connection
  url         String   // MCP server URL
  apiKey      String?  // optional API key
  createdAt   DateTime @default(now())
  lastUsed    DateTime @updatedAt
}

// Qipashuo - Store completed debate history
model DebateHistory {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       String   // The debate topic
  fullContent String   // Full JSON of the complete debate (all speeches)
  speakerCount Int      // Number of speakers (usually 19 steps)
  createdAt   DateTime @default(now())
}
